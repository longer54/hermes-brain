{
  "hermes_home": "~/.hermes",
  "vault": "~/Obsidian/Vault",
  "host": "127.0.0.1",
  "port": 8110,
  "language": "auto",
  "backend": "",
  "agents": {
    "": "Hermes",
    "research": "Research"
  },
  "private_folders": [
    "Journal"
  ],
  "services": [
    {
      "id": "x_github",
      "label": "GitHub",
      "match": "github\\.com|\\bgh "
    },
    {
      "id": "x_youtube",
      "label": "YouTube",
      "match": "yt-dlp|youtube"
    },
    {
      "id": "x_ha",
      "label": "Home Assistant",
      "match": "homeassistant|:8123",
      "local": true
    }
  ],
  "hosts": [
    {
      "id": "x_server",
      "label": "My server",
      "match": "\\bmy-server\\b"
    }
  ]
}
